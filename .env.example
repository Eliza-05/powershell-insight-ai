# =====================================================================
# PowerShell Insight AI — variables de entorno de ejemplo
# Copiar a `.env` y ajustar localmente. `.env` nunca se versiona.
# Este archivo NO debe contener secretos.
# =====================================================================

# --- Ollama (LLM local) ---------------------------------------------
# URL del servidor Ollama local.
OLLAMA_BASE_URL=http://localhost:11434
# Modelo candidato (provisional; se validará en la Fase 0).
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Backend (FastAPI) ----------------------------------------------
# Escuchar solo en loopback por defecto: la herramienta es de uso local.
API_HOST=127.0.0.1
API_PORT=8000

# --- Límites de análisis --------------------------------------------
# Tamaño máximo aceptado por script, en bytes (valor provisional).
MAX_SCRIPT_SIZE_BYTES=1048576
