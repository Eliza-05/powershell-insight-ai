    "start_line": "Primera linea del fragmento (base 1), referida al archivo indicado por evidence_source.",
    "end_line": "Ultima linea del fragmento (base 1); igual a start_line si ocupa una sola linea.",
    "transformation_id": "Identificador de la transformacion o artefacto recuperado al que se refieren las lineas. null cuando evidence_source es 'original'.",
    "verification_status": "Estado de verificacion de la evidencia.",
    "annotator": "Iniciales de quien registro la anotacion.",
    "notes": "Notas libres, p. ej., subtipo de B07 o motivo de rechazo.",
    "file_ref": "Archivo del repositorio al que se refieren start_line y end_line."
